# Organic Mind — environment variable template
#
# Copy this file to `.env` (frontend) and/or export the backend variables in
# your shell. Vite reads `.env` automatically for VITE_* vars, but Django reads
# os.environ directly — it does NOT load `.env`, so export DJANGO_* / REDIS_URL
# in your environment (or use direnv / your process manager).
#
# Every variable has a safe development default. Set them explicitly in
# production, especially DJANGO_DEBUG=False (which then requires
# DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS).

# ===================== Backend (Django) =====================

# True enables dev defaults (insecure secret key, localhost hosts, console
# email). Set to False in production.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hosts the server will answer. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed by CORS. Defaults to local dev origins.
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email. The console backend prints verification emails to the server log (dev).
# Point at an SMTP backend in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Organic Mind <noreply@organicmind.local>

# Auth hardening.
DJANGO_TOKEN_EXPIRY_DAYS=30
DJANGO_WS_TICKET_MAX_AGE=60
# Email verification link lifetime, in seconds (default: 3 days).
DJANGO_EMAIL_VERIFICATION_MAX_AGE=259200

# Logging level (DEBUG, INFO, WARNING, ERROR).
DJANGO_LOG_LEVEL=INFO

# Optional Redis URL for the Channels layer (required for WebSockets across
# multiple processes). Falls back to an in-memory layer (single process, dev
# only) when unset.
REDIS_URL=

# ===================== Frontend (Vite) =====================

# Base URL of the Django API that the SPA talks to.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
