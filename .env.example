# Organic Mind — environment variable template
#
# Copy this file to `.env` (frontend) and/or export the backend variables in
# your shell. Vite reads `.env` automatically for VITE_* vars, but Django reads
# os.environ directly — it does NOT load `.env`, so export DJANGO_* in your
# environment (or use direnv / your process manager).
#
# Every variable has a safe development default. Set them explicitly in
# production, especially DJANGO_DEBUG=False (which then requires
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, DJANGO_CORS_ORIGINS and
# DJANGO_DATABASE_URL).

# ===================== Backend (Django) =====================

# True enables dev defaults (insecure secret key, localhost hosts/origins,
# SQLite). Set to False in production.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hosts the server will answer. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed by CORS. Defaults to local dev
# origins; required when DJANGO_DEBUG=False.
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database URL. Required when DJANGO_DEBUG=False (SQLite is a dev-only
# default). Examples:
#   postgres://user:password@host:5432/organic_mind
#   sqlite:///db.sqlite3
DJANGO_DATABASE_URL=

# Auth hardening.
DJANGO_TOKEN_EXPIRY_DAYS=30

# Logging level (DEBUG, INFO, WARNING, ERROR).
DJANGO_LOG_LEVEL=INFO

# ===================== Frontend (Vite) =====================

# Base URL of the Django API that the SPA talks to.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
